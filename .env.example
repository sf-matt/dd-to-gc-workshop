# Copy to .env, fill in your values, then `source .env` before running the
# kubectl/curl commands in README.md, observability/README.md, and groundcover/README.md.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# groundcover sensor ingestion token — from `groundcover auth get-ingestion-key sensor`,
# or your groundcover account's Settings > Ingestion Keys. Used by groundcover/README.md's
# Helm install; never gets written into groundcover/values.yaml.
GROUNDCOVER_TOKEN=
