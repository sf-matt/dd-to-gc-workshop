{
  "title": "DD→GC Workshop: 2. Latency & Errors",
  "description": "Per-service latency percentiles and error rate, built from trace.flask.request.* APM auto-metrics (verified live against this org — see observability/README.md before assuming trace.http.request.* works elsewhere).",
  "layout_type": "ordered",
  "template_variables": [
    { "name": "env", "prefix": "env", "available_values": ["workshop"], "default": "workshop" }
  ],
  "widgets": [
    {
      "definition": {
        "type": "timeseries",
        "title": "payment-svc Latency (p50 / p95 / p99)",
        "requests": [
          {
            "queries": [
              { "data_source": "metrics", "name": "p50", "query": "p50:trace.flask.request{service:payment-svc,env:$env}" },
              { "data_source": "metrics", "name": "p95", "query": "p95:trace.flask.request{service:payment-svc,env:$env}" },
              { "data_source": "metrics", "name": "p99", "query": "p99:trace.flask.request{service:payment-svc,env:$env}" }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": { "scale": "linear", "label": "seconds" }
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "order-api Latency (p50 / p95 / p99)",
        "requests": [
          {
            "queries": [
              { "data_source": "metrics", "name": "p50", "query": "p50:trace.flask.request{service:order-api,env:$env}" },
              { "data_source": "metrics", "name": "p95", "query": "p95:trace.flask.request{service:order-api,env:$env}" },
              { "data_source": "metrics", "name": "p99", "query": "p99:trace.flask.request{service:order-api,env:$env}" }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": { "scale": "linear", "label": "seconds" }
      }
    },
    {
      "definition": {
        "type": "timeseries",
        "title": "Error Rate % by Service",
        "requests": [
          {
            "formulas": [{ "formula": "(errors / hits) * 100", "alias": "error rate %" }],
            "queries": [
              { "data_source": "metrics", "name": "hits", "query": "sum:trace.flask.request.hits{env:$env} by {service}.as_count()" },
              { "data_source": "metrics", "name": "errors", "query": "sum:trace.flask.request.hits.by_http_status{env:$env,http.status_class:5xx} by {service}.as_count()" }
            ],
            "response_format": "timeseries",
            "display_type": "line"
          }
        ],
        "yaxis": { "scale": "linear", "label": "%" }
      }
    },
    {
      "definition": {
        "type": "toplist",
        "title": "Top Endpoints by Error Count",
        "requests": [
          {
            "queries": [
              { "data_source": "metrics", "name": "query1", "query": "sum:trace.flask.request.hits.by_http_status{env:$env,http.status_class:5xx} by {resource_name}.as_count()" }
            ],
            "response_format": "scalar"
          }
        ]
      }
    }
  ]
}
